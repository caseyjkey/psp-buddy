diff --git a/hosts/psp/src/persist.rs b/hosts/psp/src/persist.rs
new file mode 100644
--- /dev/null
+++ b/hosts/psp/src/persist.rs
@@ -0,0 +1,53 @@
+//! Tiny app-state store for standalone PSP programs.
+use alloc::string::String;
+use core::ffi::c_void;
+use psp::sys::{self, IoOpenFlags, IoWhence};
+
+const MAX_BYTES: usize = 4096;
+const DIR: &[u8] = b"ms0:/PSP/SAVEDATA/PSPBUDDY\0";
+const STATE: &[u8] = b"ms0:/PSP/SAVEDATA/PSPBUDDY/state.json\0";
+const NEXT: &[u8] = b"ms0:/PSP/SAVEDATA/PSPBUDDY/state.next\0";
+
+unsafe fn read_path(path: &[u8]) -> Option<String> {
+    let fd = sys::sceIoOpen(path.as_ptr(), IoOpenFlags::RD_ONLY, 0o777);
+    if fd.0 < 0 { return None; }
+    let len = sys::sceIoLseek(fd, 0, IoWhence::End);
+    if len <= 0 || len as usize > MAX_BYTES {
+        sys::sceIoClose(fd);
+        return None;
+    }
+    sys::sceIoLseek(fd, 0, IoWhence::Set);
+    let mut bytes = alloc::vec![0u8; len as usize];
+    let mut read = 0usize;
+    while read < bytes.len() {
+        let n = sys::sceIoRead(fd, bytes.as_mut_ptr().add(read) as *mut c_void, (bytes.len() - read) as u32);
+        if n <= 0 { break; }
+        read += n as usize;
+    }
+    sys::sceIoClose(fd);
+    if read != bytes.len() { return None; }
+    String::from_utf8(bytes).ok()
+}
+
+pub unsafe fn read() -> Option<String> {
+    read_path(STATE).or_else(|| read_path(NEXT))
+}
+
+pub unsafe fn write(bytes: &[u8]) -> bool {
+    if bytes.is_empty() || bytes.len() > MAX_BYTES || core::str::from_utf8(bytes).is_err() {
+        return false;
+    }
+    sys::sceIoMkdir(DIR.as_ptr(), 0o777);
+    let fd = sys::sceIoOpen(NEXT.as_ptr(), IoOpenFlags::WR_ONLY | IoOpenFlags::CREAT | IoOpenFlags::TRUNC, 0o777);
+    if fd.0 < 0 { return false; }
+    let mut written = 0usize;
+    while written < bytes.len() {
+        let n = sys::sceIoWrite(fd, bytes.as_ptr().add(written) as *const c_void, bytes.len() - written);
+        if n <= 0 { break; }
+        written += n as usize;
+    }
+    sys::sceIoClose(fd);
+    if written != bytes.len() { return false; }
+    sys::sceIoRemove(STATE.as_ptr());
+    sys::sceIoRename(NEXT.as_ptr(), STATE.as_ptr()) >= 0
+}
diff --git a/hosts/psp/src/system_info.rs b/hosts/psp/src/system_info.rs
new file mode 100644
--- /dev/null
+++ b/hosts/psp/src/system_info.rs
@@ -0,0 +1,19 @@
+//! Low-frequency wall-clock and power snapshot for desk applications.
+use alloc::string::String;
+use psp::sys::{self, ScePspDateTime};
+
+pub unsafe fn json() -> String {
+    let mut now = ScePspDateTime::default();
+    let rtc_ok = sys::sceRtcGetCurrentClockLocalTime(&mut now) >= 0;
+    let mut epoch = 0u64;
+    if rtc_ok { sys::sceRtcGetTime64_t(&now, &mut epoch); }
+    let battery = sys::scePowerGetBatteryLifePercent();
+    let minutes = sys::scePowerGetBatteryLifeTime();
+    alloc::format!(
+        "{{\"year\":{},\"month\":{},\"day\":{},\"hour\":{},\"minute\":{},\"second\":{},\"epoch\":{},\"battery\":{},\"batteryMinutes\":{},\"charging\":{},\"powerOnline\":{}}}",
+        now.year, now.month, now.day, now.hour, now.minutes, now.seconds,
+        epoch, battery, minutes,
+        sys::scePowerIsBatteryCharging() > 0,
+        sys::scePowerIsPowerOnline() > 0,
+    )
+}
