+/// Standalone PSP utility surface. These bounded operations are optional host
+/// enhancements rather than portable PocketJS spec ops.
+unsafe extern "C" fn js_persist_read(
+    ctx: *mut JSContext,
+    _this: JSValue,
+    _argc: i32,
+    _argv: *mut JSValue,
+) -> JSValue {
+    match crate::persist::read() {
+        Some(s) => JS_NewStringLen(ctx, s.as_ptr(), s.len()),
+        None => JS_UNDEFINED,
+    }
+}
+
+unsafe extern "C" fn js_persist_write(
+    ctx: *mut JSContext,
+    _this: JSValue,
+    argc: i32,
+    argv: *mut JSValue,
+) -> JSValue {
+    let ok = if argc < 1 {
+        false
+    } else {
+        let mut len: size_t = 0;
+        let s = JS_ToCStringLen2(ctx, &mut len, *argv.offset(0), 0);
+        if s.is_null() {
+            false
+        } else {
+            let ok = crate::persist::write(core::slice::from_raw_parts(s as *const u8, len));
+            JS_FreeCString(ctx, s);
+            ok
+        }
+    };
+    JS_NewBool(ctx, ok)
+}
+
+unsafe extern "C" fn js_system_snapshot(
+    ctx: *mut JSContext,
+    _this: JSValue,
+    _argc: i32,
+    _argv: *mut JSValue,
+) -> JSValue {
+    let s = crate::system_info::json();
+    JS_NewStringLen(ctx, s.as_ptr(), s.len())
+}
+
+unsafe extern "C" fn js_keep_awake_tick(
+    _ctx: *mut JSContext,
+    _this: JSValue,
+    _argc: i32,
+    _argv: *mut JSValue,
+) -> JSValue {
+    let _ = psp::sys::scePowerTick(psp::sys::PowerTick::All);
+    JS_UNDEFINED
+}
