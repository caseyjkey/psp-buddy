# Optional runtime configuration for bridge/server.js.
# Copy to .env locally; never commit the copy.
PSP_BUDDY_BIND=0.0.0.0
PSP_BUDDY_PORT=17322
PSP_BUDDY_POLL_MS=10000
PSP_BUDDY_UPSTREAM_TIMEOUT_MS=15000
TOKEN_MONITOR_HUB_URL=http://127.0.0.1:17321
# Optional SSH-reachable OpenClaw host for live agent counts.
# PSP_BUDDY_REMOTE_OPENCLAW_HOST=omarchy
# PSP_BUDDY_REMOTE_OPENCLAW_PROBE=/home/beast/Development/psp-buddy/bridge/live-agent-probe.js
# Set this directly, or leave unset to read Token Monitor's local credential file.
# TOKEN_MONITOR_SECRET=
# TOKEN_MONITOR_CREDENTIAL_FILE=
